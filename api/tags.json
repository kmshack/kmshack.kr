---
layout: null
sitemap: false
---
{
  "count": {{ site.tags | size }},
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "tags": [
    {%- for tag in site.tags %}
    {%- assign slug = tag[0] | slugify %}
    {
      "name": {{ tag[0] | jsonify }},
      "slug": {{ slug | jsonify }},
      "url": {{ slug | prepend: "/blog/tags/#tag-" | absolute_url | jsonify }},
      "count": {{ tag[1] | size }},
      "posts": [{% for post in tag[1] %}{{ post.url | split: "/" | last | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}]
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
