---
layout: null
sitemap: false
---
{
  "count": {{ site.posts | size }},
  "language": "ko",
  "feed": "https://kmshack.kr/blog/feed.xml",
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "posts": [
    {%- for post in site.posts %}
    {%- assign summary = post.description | default: post.excerpt | strip_html | strip_newlines | strip | truncate: 200 %}
    {
      "id": {{ post.url | split: "/" | last | jsonify }},
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }},
      "modified": {{ post.last_modified_at | default: post.date | date_to_xmlschema | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "summary": {{ summary | jsonify }},
      "language": {{ post.lang | default: "ko" | jsonify }},
      "legacy": {{ post.legacy | default: false | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
